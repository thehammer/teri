#!/usr/bin/env bash
# teri-cache-refresh — pull fresh data from global service libs into the Teri cache.
#
# The global service libs (~/.claude/lib/services/*.sh, read-only) are wrapped by thin
# adapters in lib/adapters.sh, which print the JSON shapes Teri caches:
#   jira_fetch_my_issues, jira_fetch_issue KEY, sentry_fetch_recent_unresolved,
#   calendar_fetch_today, email_fetch_inbox_summary
#
# Every source ends in exactly one of three states, printed one line per source:
#   ok      fetched, N>0 items, cache written
#   empty   fetched fine, zero items, cache written (a real answer, not an error)
#   FAILED  could not be fetched (lib/function missing, creds, auth, API, bad JSON,
#           timeout). Cache is left untouched.
# Exit: 0 = no source failed; 1 = at least one failed ("PARTIAL" if some succeeded,
# "FAILED" if none); 2 = usage.
#
# Test/override env: TERI_SERVICES_DIR (default ~/.claude/lib/services),
# TERI_CREDENTIALS_LIB (default ~/.claude/lib/core/credentials.sh),
# TERI_REFRESH_TIMEOUT (seconds per source, default 30).
set -euo pipefail

TERI_REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
export TERI_REPO_ROOT

source "${TERI_REPO_ROOT}/lib/teri.sh"
source "${TERI_REPO_ROOT}/lib/cache.sh"

teri_load_context

TTL_OVERRIDE=""
FORCE=0

# ---------------------------------------------------------------------------
# Loading
# ---------------------------------------------------------------------------
SERVICES_DIR="${TERI_SERVICES_DIR:-${HOME}/.claude/lib/services}"
CREDENTIALS_LIB="${TERI_CREDENTIALS_LIB:-${HOME}/.claude/lib/core/credentials.sh}"
SOURCE_TIMEOUT="${TERI_REFRESH_TIMEOUT:-30}"

lib_path() { echo "${SERVICES_DIR}/${1}.sh"; }
lib_exists() { [[ -f "$(lib_path "$1")" ]]; }

# Source credentials (if present), the named service libs, then the Teri adapters.
# Prints a reason to stderr and returns 1 on any problem. Run inside a per-source subshell.
load_for() {
  local name
  if [[ -f "$CREDENTIALS_LIB" ]]; then
    # shellcheck disable=SC1090
    source "$CREDENTIALS_LIB" >/dev/null 2>&1 || true
  fi
  for name in "$@"; do
    if ! lib_exists "$name"; then
      echo "service lib not found: $(lib_path "$name")" >&2
      return 1
    fi
    # shellcheck disable=SC1090
    source "$(lib_path "$name")" >/dev/null 2>&1 || { echo "failed to source ${name}.sh" >&2; return 1; }
  done
  if [[ ! -f "${TERI_REPO_ROOT}/lib/adapters.sh" ]]; then
    echo "adapters missing: ${TERI_REPO_ROOT}/lib/adapters.sh" >&2
    return 1
  fi
  # shellcheck disable=SC1091
  source "${TERI_REPO_ROOT}/lib/adapters.sh"
}

# ---------------------------------------------------------------------------
# Refresh: runs in a subshell. Prints "<state>\t<detail>" on stdout; rc 0 for
# ok/empty, 1 for failed.
#   refresh_source <libs> <ns> <key> <count-jq> <fn> [args...]
# ---------------------------------------------------------------------------
refresh_source() {
  set +eu
  local libs="$1" ns="$2" key="$3" count_expr="$4" fn="$5"; shift 5
  local err_file; err_file="$(mktemp -t teri-refresh-err.XXXXXX)"
  local reason result count

  fail() { printf 'failed\t%s\n' "$1"; rm -f "$err_file"; return 1; }

  # shellcheck disable=SC2086
  load_for $libs 2>"$err_file" || { reason="$(head -n1 "$err_file" | cut -c1-200)"; fail "${reason:-load failed}"; return 1; }

  if ! declare -f "$fn" >/dev/null 2>&1; then
    fail "adapter ${fn} not defined"; return 1
  fi

  result="$("$fn" "$@" 2>"$err_file")" || {
    reason="$(head -n1 "$err_file" | cut -c1-200)"
    fail "${fn}: ${reason:-failed with no message}"; return 1
  }
  if ! jq -e . >/dev/null 2>&1 <<<"$result"; then
    fail "${fn}: returned no valid JSON"; return 1
  fi
  count="$(jq -r "$count_expr" <<<"$result" 2>/dev/null)"
  if ! [[ "$count" =~ ^[0-9]+$ ]]; then
    fail "${fn}: could not count items"; return 1
  fi

  cache_put "$ns" "$key" "$result"
  rm -f "$err_file"
  if [[ "$count" -eq 0 ]]; then
    printf 'empty\t0 items\n'
  else
    printf 'ok\t%s item(s)\n' "$count"
  fi
}

refresh_jira_mine() { refresh_source "jira"     jira     _my_issues 'length'          jira_fetch_my_issues; }
refresh_jira_key()  { refresh_source "jira"     jira     "$1"       'if .key then 1 else 0 end' jira_fetch_issue "$1"; }
refresh_email()     { refresh_source "m365"     email    inbox      '.count'          email_fetch_inbox_summary; }
refresh_calendar()  { refresh_source "calendar" calendar today      '.events | length' calendar_fetch_today; }
refresh_sentry()    { refresh_source "sentry"   sentry   recent     'length'          sentry_fetch_recent_unresolved; }

# ---------------------------------------------------------------------------
# Runner: run sources concurrently with a per-source timeout, then report.
#   run_sources "label:function[:arg]" ...
# ---------------------------------------------------------------------------
run_sources() {
  local dir; dir="$(mktemp -d -t teri-refresh.XXXXXX)"
  local spec label fn arg pids=() labels=()
  for spec in "$@"; do
    label="${spec%%:*}"; fn="${spec#*:}"; arg=""
    if [[ "$fn" == *:* ]]; then arg="${fn#*:}"; fn="${fn%%:*}"; fi
    (
      if [[ -n "$arg" ]]; then "$fn" "$arg"; else "$fn"; fi
      echo $? > "${dir}/${label}.rc.tmp"; mv "${dir}/${label}.rc.tmp" "${dir}/${label}.rc"
    ) > "${dir}/${label}.out" 2>/dev/null 3>&- &
    local pid=$!
    ( sleep "$SOURCE_TIMEOUT"; pkill -TERM -P "$pid" 2>/dev/null; kill -TERM "$pid" 2>/dev/null ) >/dev/null 2>&1 3>&- &
    pids+=("$pid"); labels+=("$label")
    watchdogs+=("$!")
  done

  local i n_fail=0 n_good=0 failed_labels="" state detail
  for i in "${!pids[@]}"; do
    wait "${pids[$i]}" 2>/dev/null || true
    pkill -TERM -P "${watchdogs[$i]}" 2>/dev/null || true
    kill "${watchdogs[$i]}" 2>/dev/null || true
    label="${labels[$i]}"
    state=""; detail=""
    if [[ -f "${dir}/${label}.rc" && -s "${dir}/${label}.out" ]]; then
      IFS=$'\t' read -r state detail < "${dir}/${label}.out" || true
    fi
    case "$state" in
      ok|empty) n_good=$((n_good + 1)); printf '%-9s %-6s %s\n' "$label" "$state" "$detail" ;;
      *)
        n_fail=$((n_fail + 1)); failed_labels+="${failed_labels:+, }${label}"
        [[ -n "$detail" ]] || detail="no result (timed out after ${SOURCE_TIMEOUT}s or crashed)"
        printf '%-9s %-6s %s\n' "$label" "FAILED" "$detail"
        teri_log error "cache refresh ${label} FAILED: ${detail}" ;;
    esac
  done
  rm -rf "$dir"

  if [[ $n_fail -eq 0 ]]; then
    echo "refresh: all ${n_good} source(s) fetched"
    return 0
  elif [[ $n_good -eq 0 ]]; then
    echo "refresh: FAILED (${failed_labels})"
  else
    echo "refresh: PARTIAL, ${n_good} fetched, ${n_fail} failed (${failed_labels})"
  fi
  return 1
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
CMD="${1:-all}"
shift || true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ttl)   TTL_OVERRIDE="$2"; shift 2 ;;
    --force) FORCE=1; shift ;;
    *)       break ;;
  esac
done

watchdogs=()

case "$CMD" in
  jira)
    if [[ -n "${1:-}" ]]; then
      run_sources "jira:refresh_jira_key:$1"
    else
      run_sources "jira:refresh_jira_mine"
    fi ;;
  email)    run_sources "email:refresh_email" ;;
  calendar) run_sources "calendar:refresh_calendar" ;;
  sentry)   run_sources "sentry:refresh_sentry" ;;
  all)
    run_sources "jira:refresh_jira_mine" "sentry:refresh_sentry" \
                "calendar:refresh_calendar" "email:refresh_email" ;;
  *)
    echo "Usage: teri-cache-refresh [jira [KEY]|email|calendar|sentry|all] [--ttl N] [--force]" >&2
    exit 2 ;;
esac
